{
  "name": "drafteine-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drafteine \u2014 draft file trees as text, preview them live, materialize them for real.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @drafteine/core && vite playground",
    "build": "npm run build -w @drafteine/core && vite build playground",
    "preview": "vite preview playground",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/cli && tsc -p packages/language-server && tsc -p packages/vscode-extension"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "@drafteine/core": "^0.15.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenddawson/drafteine.git"
  },
  "homepage": "https://github.com/owenddawson/drafteine#readme",
  "bugs": {
    "url": "https://github.com/owenddawson/drafteine/issues"
  }
}