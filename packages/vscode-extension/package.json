{
  "name": "drafteine",
  "displayName": "Drafteine",
  "description": "Draft file trees as text: live diagnostics, IntelliSense, preview, and one-click materialization for .dft files.",
  "version": "0.14.0",
  "publisher": "drafteine",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:drafteine.config.json",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "drafteine",
        "aliases": [
          "Drafteine",
          "dft"
        ],
        "extensions": [
          ".dft"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/dft-light.svg",
          "dark": "./media/dft-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "drafteine",
        "scopeName": "source.drafteine",
        "path": "./syntaxes/drafteine.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "drafteine.showPreview",
        "title": "Drafteine: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "drafteine.applyDraft",
        "title": "Drafteine: Apply Draft to Workspace"
      },
      {
        "command": "drafteine.toggleStructureView",
        "title": "Drafteine: Toggle Structure View (Dim Annotations)"
      },
      {
        "command": "drafteine.openSettings",
        "title": "Drafteine: Open Settings"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "drafteine.showPreview",
          "when": "editorLangId == drafteine"
        },
        {
          "command": "drafteine.applyDraft",
          "when": "editorLangId == drafteine"
        },
        {
          "command": "drafteine.toggleStructureView",
          "when": "editorLangId == drafteine"
        }
      ],
      "editor/title": [
        {
          "command": "drafteine.showPreview",
          "when": "editorLangId == drafteine",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[drafteine]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.stickyScroll.enabled": true
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/drafteine-fence.css",
      "./media/filecolors.css"
    ],
    "configuration": {
      "title": "Drafteine",
      "properties": {
        "drafteine.preview.theme": {
          "type": "string",
          "enum": [
            "colored",
            "minimal",
            "espresso"
          ],
          "enumDescriptions": [
            "Manila folders and file icons colored by language, using GitHub Linguist's color data.",
            "Icon colors follow your editor theme.",
            "The Drafteine brand look: amber folders, blueprint files."
          ],
          "default": "colored",
          "description": "Icon theme for the preview panel and markdown fences."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "drafteine.config.json"
        ],
        "url": "./schemas/drafteine.config.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "linguist-languages": "^9.4.0",
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenddawson/drafteine.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/owenddawson/drafteine#readme",
  "bugs": {
    "url": "https://github.com/owenddawson/drafteine/issues"
  }
}