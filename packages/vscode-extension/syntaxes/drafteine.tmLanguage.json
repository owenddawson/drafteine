{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Drafteine",
  "scopeName": "source.drafteine",
  "patterns": [
    {
      "comment": "Full-line or trailing comment (whitespace-preceded #)",
      "match": "(?:^|\\s)(#.*)$",
      "captures": {
        "1": { "name": "comment.line.number-sign.drafteine" }
      }
    },
    {
      "comment": "Quoted name or value",
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.drafteine"
    },
    {
      "comment": "Annotation key with optional value",
      "match": "(?:(?<=\\s)|^)(@[A-Za-z][\\w-]*)(?:(\\()([^)]*)(\\)))?",
      "captures": {
        "1": { "name": "entity.name.function.annotation.drafteine" },
        "2": { "name": "punctuation.definition.annotation.begin.drafteine" },
        "3": { "name": "string.unquoted.annotation-value.drafteine" },
        "4": { "name": "punctuation.definition.annotation.end.drafteine" }
      }
    },
    {
      "comment": "Folder line: bare name ending in /",
      "match": "^\\s*([^@#\\s][^@#]*?)(/)(?=\\s|$)",
      "captures": {
        "1": { "name": "entity.name.tag.folder.drafteine" },
        "2": { "name": "punctuation.separator.folder.drafteine" }
      }
    },
    {
      "comment": "File extension",
      "match": "(\\.[A-Za-z0-9]+)(?=\\s|$)",
      "name": "constant.other.extension.drafteine"
    },
    {
      "comment": "Block braces (v0.3 block form)",
      "match": "[{}]",
      "name": "punctuation.section.block.drafteine"
    }
  ]
}
