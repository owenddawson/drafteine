{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Drafteine",
  "scopeName": "source.drafteine",
  "patterns": [
    {
      "comment": "Version pragma (first content line)",
      "match": "^(drafteine)[ \\t]+([0-9]+)(?=[ \\t]|$)",
      "captures": {
        "1": { "name": "keyword.control.pragma.drafteine" },
        "2": { "name": "constant.numeric.version.drafteine" }
      }
    },
    {
      "comment": "Preset definition line",
      "match": "^(preset)[ \\t]+([A-Za-z][\\w-]*)",
      "captures": {
        "1": { "name": "keyword.control.preset.drafteine" },
        "2": { "name": "entity.name.function.preset.drafteine" }
      }
    },
    {
      "comment": "Full-line or trailing comment (whitespace-preceded #)",
      "match": "(?:^|\\s)(#.*)$",
      "captures": {
        "1": { "name": "comment.line.number-sign.drafteine" }
      }
    },
    {
      "comment": "Attribute container: { key: value, flag, preset: name }",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.container.begin.drafteine" } },
      "endCaptures": { "0": { "name": "punctuation.section.container.end.drafteine" } },
      "patterns": [
        {
          "match": "(?:^|\\s)(#.*)$",
          "captures": { "1": { "name": "comment.line.number-sign.drafteine" } }
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.drafteine"
        },
        {
          "comment": "key: value pair",
          "match": "([A-Za-z][\\w-]*)[ \\t]*(:)",
          "captures": {
            "1": { "name": "entity.name.function.attribute.drafteine" },
            "2": { "name": "punctuation.separator.key-value.drafteine" }
          }
        },
        {
          "comment": "Bare flag",
          "match": "[A-Za-z][\\w-]*",
          "name": "keyword.other.flag.drafteine"
        },
        {
          "match": "[\\[\\],]",
          "name": "punctuation.separator.list.drafteine"
        }
      ]
    },
    {
      "comment": "Quoted name",
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.drafteine"
    },
    {
      "comment": "Folder name ending in /, including the last segment of a folder path",
      "match": "([^#{\\s][^#{]*?)(/)(?=[\\s?]|$)",
      "captures": {
        "1": { "name": "entity.name.tag.folder.drafteine" },
        "2": { "name": "punctuation.separator.folder.drafteine" }
      }
    },
    {
      "comment": "Path separator inside a sparse path line",
      "match": "/",
      "name": "punctuation.separator.path.drafteine"
    },
    {
      "comment": "Optional sigil",
      "match": "\\?(?=\\s|$)",
      "name": "keyword.operator.optional.drafteine"
    },
    {
      "comment": "File extension",
      "match": "(\\.[A-Za-z0-9]+)(?=[\\s?]|$)",
      "name": "constant.other.extension.drafteine"
    }
  ]
}
